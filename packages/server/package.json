{
  "name": "@gammyverse/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,realtime -c cyan,blue \"pnpm dev:api\" \"pnpm dev:realtime\"",
    "dev:api": "tsx watch src/entrypoints/api.ts",
    "dev:realtime": "tsx watch src/entrypoints/realtime.ts",
    "start": "node dist/index.js",
    "start:api": "node dist/api.js",
    "start:realtime": "node dist/index.js",
    "build": "esbuild src/entrypoints/realtime.ts --bundle --platform=node --format=esm --external:@colyseus/* --external:pg --external:express --outfile=dist/index.js && esbuild src/entrypoints/api.ts --bundle --platform=node --format=esm --external:@colyseus/* --external:pg --external:express --outfile=dist/api.js",
    "test": "tsx --test src/auth.test.ts"
  },
  "dependencies": {
    "@colyseus/core": "^0.18.1",
    "@colyseus/ws-transport": "^0.18.1",
    "@gammyverse/shared": "workspace:*",
    "express": "5.2.1",
    "livekit-server-sdk": "2.19.1",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.5.2",
    "@types/pg": "^8.23.1",
    "esbuild": "0.28.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
