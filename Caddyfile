{$LIVEKIT_DOMAIN} {
	reverse_proxy livekit:7880
}

{$DOMAIN} {
	@websocket header Connection *Upgrade*
	handle @websocket {
		reverse_proxy realtime:2567
	}

	@realtime path /matchmake/* /media/*
	handle @realtime {
		reverse_proxy realtime:2567
	}

	handle /internal/* {
		respond "Not found" 404
	}

	@api path /auth/* /offices* /office-invites/* /maintainer/* /health/*
	handle @api {
		reverse_proxy api:2568
	}

	handle {
		root * /srv
		route {
			try_files {path} /index.html
			@hashedAssets path_regexp hashedAssets ^/assets/[^/]+-[A-Za-z0-9_-]{8,}\.[^/]+$
			header @hashedAssets Cache-Control "public, max-age=31536000, immutable"
			@index path /index.html
			header @index Cache-Control "no-cache"
			file_server
		}
	}
}
