# Public DNS name pointing to the production host.
DOMAIN=office.example.com
LIVEKIT_DOMAIN=media.example.com

# Generate with: openssl rand -base64 36
POSTGRES_PASSWORD=replace-with-a-long-random-secret
APP_DB_PASSWORD=replace-with-a-different-long-random-secret

# Shared only by the API and realtime containers for authenticated internal control calls.
INTERNAL_SERVICE_TOKEN=replace-with-a-third-long-random-secret-at-least-32-characters

# Generate a unique key and secret pair for the self-hosted LiveKit service.
LIVEKIT_API_KEY=gammyverse
LIVEKIT_API_SECRET=replace-with-at-least-32-random-characters

# Set to 1 for the first startup only if migrating data/auth-users.json from the prototype.
IMPORT_LEGACY_AUTH=
